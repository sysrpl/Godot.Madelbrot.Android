; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited
; using the UI and not by hand, with the exception of the
; "script_classes" section, which should be edited by hand.

config_version=5

[application]

config/name="mandelbrot"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://icon.svg"
boot_splash/show_image=false

[display]

window/handheld/orientation=6

[dotnet]

project/assembly_name="mandelbrot"

[gui]

theme/custom="res://resources/themes/minimal.tres"

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
